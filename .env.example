# DocuMind - Environment Configuration Example

# Langflow Server Settings
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=your-documind-flow-id-here
LANGFLOW_API_KEY=your-langflow-api-key-here

# Langflow Superuser Authentication Credentials
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=adminpassword123

# JWT Authentication Settings
LANGFLOW_SECRET_KEY=documind-super-secret-jwt-key-2026
LANGFLOW_ALGORITHM=HS256

# Application Configuration
APP_ENV=development
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
DEMO_MODE=false
